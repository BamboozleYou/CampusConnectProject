<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvLogo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CAMPUSCONNECT"
            android:textColor="@color/teal_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_top_toTopOf="parent" />

        <TextView
            android:id="@+id/tvCollegeName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BMS College of Engineering"
            android:textColor="@color/text_grey"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_top_toBottomOf="@id/tvLogo" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/teal_primary"
            android:text="Login"
            android:textAllCaps="false"
            android:textColor="@color/background"
            app:cornerRadius="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_top_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/tabLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal"
            app:layout_top_toBottomOf="@id/tvCollegeName">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPosterboard"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="Posterboard"
                android:textColor="@color/teal_primary"
                app:icon="@drawable/ic_grid"
                app:iconTint="@color/teal_primary"
                app:strokeColor="@color/teal_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpportunities"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Opportunities"
                android:textColor="@color/text_grey"
                app:icon="@drawable/ic_briefcase"
                app:iconTint="@color/text_grey"
                app:strokeColor="@color/text_grey" />
        </LinearLayout>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="24dp"
            app:layout_constraintTop_toBottomOf="@id/tabLayout">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/ivPoster"
                    android:layout_width="match_parent"
                    android:layout_height="250dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/trek_poster"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Intro-Trek"
                    android:textColor="@color/text_white"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/ivPoster" />

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Completed"
                    android:textColor="@color/text_grey"
                    app:layout_constraintBottom_toBottomOf="@id/tvTitle"
                    app:layout_constraintStart_toEndOf="@id/tvTitle"
                    app:layout_constraintTop_toTopOf="@id/tvTitle" />

                <TextView
                    android:id="@+id/tvPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹500"
                    android:textColor="@color/gold"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tvTitle" />

                <TextView
                    android:id="@+id/tvClub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mountaineering Club of BMSCE"
                    android:textColor="@color/text_white"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvTitle" />

                <TextView
                    android:id="@+id/tvDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="First-years exclusive!! Join us on this amazing and therapeutic trek to the outskirts of Namma Bengaluru"
                    android:textColor="@color/text_grey"
                    android:textSize="16sp"
                    app:layout_constraintTop_toBottomOf="@id/tvClub" />

                <ImageView
                    android:id="@+id/icDate"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginTop="16dp"
                    android:src="@drawable/ic_calendar"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvDescription" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Sun, Jan 4, 2026"
                    android:textColor="@color/text_grey"
                    android:textSize="16sp"
                    app:layout_constraintBottom_toBottomOf="@id/icDate"
                    app:layout_constraintStart_toEndOf="@id/icDate"
                    app:layout_constraintTop_toTopOf="@id/icDate" />

                <ImageView
                    android:id="@+id/icTime"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginTop="16dp"
                    android:src="@drawable/ic_clock"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/icDate" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="06:00 AM"
                    android:textColor="@color/text_grey"
                    android:textSize="16sp"
                    app:layout_constraintBottom_toBottomOf="@id/icTime"
                    app:layout_constraintStart_toEndOf="@id/icTime"
                    app:layout_constraintTop_toTopOf="@id/icTime" />

                <ImageView
                    android:id="@+id/icLocation"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginTop="16dp"
                    android:src="@drawable/ic_location"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/icTime" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Ramadevara Betta"
                    android:textColor="@color/text_grey"
                    android:textSize="16sp"
                    app:layout_constraintBottom_toBottomOf="@id/icLocation"
                    app:layout_constraintStart_toEndOf="@id/icLocation"
                    app:layout_constraintTop_toTopOf="@id/icLocation" />

                <LinearLayout
                    android:id="@+id/tagContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal"
                    app:layout_constraintTop_toBottomOf="@id/icLocation">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_tag"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="4dp"
                        android:text="Social"
                        android:textColor="@color/teal_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_tag"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="4dp"
                        android:text="Sports"
                        android:textColor="@color/teal_primary" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRegister"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="20dp"
                    android:backgroundTint="@color/background"
                    android:text="REGISTER"
                    android:textColor="@color/text_white"
                    android:textSize="18sp"
                    app:cornerRadius="8dp"
                    app:layout_constraintTop_toBottomOf="@id/tagContainer"
                    app:strokeColor="@color/teal_primary"
                    app:strokeWidth="1dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal"
                    app:layout_constraintTop_toBottomOf="@id/btnRegister">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnInstagram"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/background"
                        android:text="Instagram"
                        android:textColor="@color/text_white"
                        app:icon="@drawable/ic_instagram" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFeedback"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/background"
                        android:text="Feedback"
                        android:textColor="@color/text_white"
                        app:icon="@drawable/ic_feedback" />
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>